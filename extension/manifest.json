{
 "manifest_version":3,"name":"DailyPS Hub","version":"1.0.2","minimum_chrome_version":"111",
 "description":"리트코드·프로그래머스에서 통과한 코드를 Hoya324/DailyPS 등 지정한 GitHub 저장소에 저장합니다.",
 "permissions":["storage","alarms"],
 "host_permissions":["https://api.github.com/*"],
 "background":{"service_worker":"background.js","type":"module"},
 "action":{"default_popup":"popup.html","default_title":"DailyPS Hub"},
 "options_page":"options.html",
 "icons":{"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"},
 "content_scripts":[
  {"matches":["https://leetcode.com/*","https://school.programmers.co.kr/learn/courses/30/lessons/*"],"js":["relay.js"],"run_at":"document_start"},
  {"matches":["https://leetcode.com/*","https://school.programmers.co.kr/learn/courses/30/lessons/*"],"js":["lib/capture.js","bridge.js"],"run_at":"document_start","world":"MAIN"}
 ],
 "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'"}
}
